# Copy this to .env for local development. On Railway, set these as
# environment variables in your service settings instead — DATABASE_URL is
# set automatically when you attach a Postgres plugin.

# Automatically provided by Railway's Postgres plugin. For local dev, point
# this at a local Postgres instance, e.g.:
# postgresql://postgres:postgres@localhost:5432/jcf_petition
DATABASE_URL=

# The single admin password used to log into /admin. Pick something strong.
ADMIN_PASSWORD=changeme

# Random long string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changeme-too

# Only set this to "true" if you point DATABASE_URL at an external Postgres
# provider that requires SSL (Railway's own internal connection does not).
PGSSL=false

# Railway sets PORT automatically; only needed for local dev if you want a
# non-default port.
PORT=3000
