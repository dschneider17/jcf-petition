<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin &middot; JCF Petition</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <header class="admin-header">
    <div class="wrap">
      <strong>JCF Petition &mdash; Admin</strong>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="link-btn">Log out</button>
      </form>
    </div>
  </header>

  <div class="wrap admin-wrap">
    <div class="filter-tabs">
      <a href="/admin?status=all" class="<%= filter === 'all' ? 'active' : '' %>">All</a>
      <a href="/admin?status=pending" class="<%= filter === 'pending' ? 'active' : '' %>">Pending</a>
      <a href="/admin?status=approved" class="<%= filter === 'approved' ? 'active' : '' %>">Approved</a>
      <a href="/admin?status=hidden" class="<%= filter === 'hidden' ? 'active' : '' %>">Hidden</a>
    </div>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Nonprofit</th>
          <th>Signer</th>
          <th>Wants</th>
          <th>Status</th>
          <th>Submitted</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% signers.forEach(function(s) { %>
          <tr>
            <td><strong><%= s.nonprofit_name %></strong><br/><span style="color:#888;font-size:0.8rem;"><%= s.email %></span></td>
            <td><%= s.signer_name %><br/><span style="color:#888;font-size:0.8rem;"><%= s.signer_role %></span></td>
            <td>
              <% if (s.wants_dafpay) { %><span class="badge badge-dafpay">DAFpay</span><% } %>
              <% if (s.wants_gift_processing) { %><span class="badge badge-gp">GP</span><% } %>
            </td>
            <td><span class="status-pill status-<%= s.status %>"><%= s.status %></span></td>
            <td style="white-space:nowrap;"><%= new Date(s.created_at).toLocaleDateString() %></td>
            <td>
              <div class="row-actions">
                <a class="btn" href="/admin/signer/<%= s.id %>">Edit</a>
                <% if (s.status !== 'approved') { %>
                  <form method="POST" action="/admin/signer/<%= s.id %>/status" style="display:inline;">
                    <input type="hidden" name="status" value="approved" />
                    <button type="submit" class="approve">Approve</button>
                  </form>
                <% } %>
                <% if (s.status !== 'hidden') { %>
                  <form method="POST" action="/admin/signer/<%= s.id %>/status" style="display:inline;">
                    <input type="hidden" name="status" value="hidden" />
                    <button type="submit" class="hide">Hide</button>
                  </form>
                <% } %>
                <form method="POST" action="/admin/signer/<%= s.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete this submission permanently?');">
                  <button type="submit" class="delete">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
        <% if (signers.length === 0) { %>
          <tr><td colspan="6" style="color:#888;">No submissions in this filter yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
