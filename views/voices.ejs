<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Voices for JCF Connectivity</title>
  <meta name="description" content="Every nonprofit voice asking Jewish Communal Fund to support Chariot Gift Processing ACH linkage." />
  <link rel="stylesheet" href="/css/colors_and_type.css" />
  <link rel="stylesheet" href="/css/site.css" />
</head>
<body>

  <div class="nav-bar">
    <div class="nav-wordmark">Voices <span class="accent">for JCF Connectivity</span></div>
    <div class="nav-actions">
      <a href="/admin/login" class="btn btn-cream">Admin</a>
      <a href="/#sign" class="btn btn-navy">Add your voice</a>
    </div>
  </div>

  <div class="wrap">
    <div class="stat-row">
      <div class="stat-tile">
        <div class="num"><%= counts.total_count %></div>
        <div class="label">nonprofits signed</div>
      </div>
    </div>

    <% if (approvedSigners.length === 0) { %>
      <p class="subhead" style="padding-bottom:80px;">No supporter voices yet &mdash; be the first.</p>
    <% } else { %>
      <div class="voice-grid" style="padding-bottom:80px;">
        <% approvedSigners.forEach(function(s) { %>
          <div class="voice-card">
            <div class="voice-badges">
              <span class="badge badge-ach">ACH Linkage</span>
            </div>
            <p class="voice-quote">&ldquo;<%= s.blurb %>&rdquo;</p>
            <% if (s.mission_statement) { %>
              <div class="voice-mission"><%= s.mission_statement %></div>
            <% } %>
            <div class="voice-identity">
              <% if (s.logo_url) { %>
                <img class="voice-avatar" style="object-fit:contain; background:#fff; border:1px solid var(--border-soft);" src="<%= s.logo_url %>" alt="" />
              <% } else { %>
                <div class="voice-avatar"><%= s.initials %></div>
              <% } %>
              <div>
                <div class="voice-name"><%= s.displayName %></div>
                <div class="voice-subtitle"><%= s.displaySubtitle %></div>
              </div>
            </div>
          </div>
        <% }) %>

        <a href="/#sign" class="voice-cta-tile tall">
          <div class="label">Add your voice</div>
          <div class="arrow">&#8593;</div>
        </a>
      </div>
    <% } %>
  </div>

  <div class="site-footer no-margin">
    <div class="site-footer-inner">
      <div>
        <div class="site-footer-title">Nonprofits for JCF Connectivity</div>
        <div class="site-footer-desc">An informal coalition of nonprofits asking Jewish Communal Fund to accept Chariot Deposit Account ACH linkages.</div>
      </div>
      <div class="site-footer-partner">
        <span>In partnership with</span>
        <img src="/img/chariot-logo.svg" alt="Chariot" />
      </div>
    </div>
  </div>

</body>
</html>
